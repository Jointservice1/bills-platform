# Copy to .env and fill in. Never commit .env.

APP_NAME=PayBills
BASE_URL=http://localhost:3000
PORT=3000
ADMIN_EMAIL=you@example.com
DATABASE_PATH=./data/bills.db

# Which provider delivers airtime/data/tokens: "mock" (demo, nothing real is sold) or "vtpass".
PROVIDER=mock

# VTpass: https://www.vtpass.com/documentation  (Profile > API Keys)
# Use the sandbox while testing, then switch VTPASS_BASE_URL to https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Paystack secret key for wallet funding (sk_test_ while testing).
PAYSTACK_SECRET_KEY=

# Email (used to send password-reset codes). Defaults to Gmail SMTP.
# SMTP_USER is your Gmail address; SMTP_PASS is a Gmail App Password (not your normal password):
# Google Account > Security > 2-Step Verification > App passwords.
# Without these, codes are printed to the server console in development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional convenience fee per category, in naira (default 0).
FEE_ELECTRICITY=0
FEE_TV=0
FEE_AIRTIME=0
FEE_DATA=0
FEE_INTERNET=0
FEE_EDUCATION=0

# Shown in the site footer (optional).
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Electricity tariff per kWh in naira, by band. Used only to ESTIMATE units and how long they last.
# Defaults are approximate; update them when NERC / your DisCo changes rates.
TARIFF_BAND_A=209.5
TARIFF_BAND_B=64
TARIFF_BAND_C=52
TARIFF_BAND_D=43
TARIFF_BAND_E=40
